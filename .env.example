# Copy to .env and fill in what you have. Everything is optional.

# LLM for message writing (optional). Without it the rule-based composer is used.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# simulation (default, nothing is sent) or real (SMTP)
SENDING_MODE=simulation

# Real sending via SMTP. For Gmail use an App Password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Strongly recommended for demos: every real email goes here instead of to the creator.
TEST_RECIPIENT_OVERRIDE=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
